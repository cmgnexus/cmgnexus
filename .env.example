APP_NAME="CMG Nexus"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost

# Generate a long random value before production use.
# Example command: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
APP_KEY=change_me_generate_a_random_64_character_hex_string

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cmg_nexus
DB_USERNAME=cmg_nexus_user
DB_PASSWORD=change_me

# Optional deployment connection details.
# Keep real FTP/SFTP credentials only in .env or your hosting control panel.
DEPLOY_DRIVER=sftp
DEPLOY_HOST=example.com
DEPLOY_PORT=22
DEPLOY_USERNAME=change_me
DEPLOY_PASSWORD=change_me
DEPLOY_PATH=/home/example/public_html

MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=change_me
MAIL_PASSWORD=change_me
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="CMG Nexus"

# External service keys are optional until each integration is built.
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
GOOGLE_MAPS_API_KEY=
OPENAI_API_KEY=
